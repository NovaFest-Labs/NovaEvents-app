# ---------------------------------------------------------------------------
# NovaEvents — required environment variables
# Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------------------

# Base URL of the NovaEvents API (no trailing slash).
# Example: https://api.novaevents.xyz
# Leave empty to hit same-origin /api routes (e.g. during local development
# when the API and the Next.js app run on the same host).
# REQUIRED: the app will throw a clear error at runtime if this variable is
# not defined at all (an empty string is accepted for same-origin usage).
NEXT_PUBLIC_API_URL=
